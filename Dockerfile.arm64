# Dockerfile for ARM64 Linux AppImage build
FROM --platform=linux/arm64 node:20-bullseye

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    libfuse2 \
    file \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy project files
COPY . .

# Install Python dependencies
RUN pip3 install --upgrade pip && \
    pip3 install -r requirements-service.txt && \
    pip3 install pyinstaller

# Build service binary
RUN PYTHONPATH=src python3 -m PyInstaller taminator-service.spec --clean

# Install Node dependencies and build GUI
WORKDIR /build/gui
RUN npm ci && npm run build

# Output artifacts
WORKDIR /build
RUN mkdir -p /output && \
    cp gui/dist/*.AppImage /output/ 2>/dev/null || echo "No AppImage found" && \
    ls -lh /output/

CMD ["sh", "-c", "cp -r /output/* /artifacts/"]

