{
  "name": "taminator-gui",
  "version": "2.1.2",
  "description": "TAMINATOR - AI-Augmented TAM Assistant",
  "homepage": "https://gitlab.cee.redhat.com/jbyrd/taminator",
  "repository": {
    "type": "git",
    "url": "https://gitlab.cee.redhat.com/jbyrd/taminator.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dev": "electron . --dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:oobe": "node test-oobe-simulator.js",
    "test:oobe:interactive": "node test-oobe-interactive.js",
    "lint": "eslint 'public/js/**/*.js' main.js service-manager.js api-client.js google-auth-handler.js oobe-state.js",
    "lint:fix": "eslint 'public/js/**/*.js' main.js service-manager.js api-client.js google-auth-handler.js oobe-state.js --fix",
    "prepare": "cd .. && husky gui/.husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "author": "Jimmy Byrd",
  "license": "ISC",
  "dependencies": {
    "@patternfly/react-core": "^5.4.2",
    "@patternfly/react-icons": "^5.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-builder-squirrel-windows": "^25.1.8",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  },
  "build": {
    "appId": "com.redhat.taminator",
    "productName": "Taminator",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "service-manager.js",
      "index.html",
      "oobe-state.js",
      "oobe-wizard.html",
      "logs-viewer.html",
      "intelligence-analyzer.html",
      "public/**/*",
      "themes/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin/tam-rfe",
        "to": "bin/tam-rfe"
      },
      {
        "from": "../dist/taminator-service",
        "to": "bin/taminator-service"
      },
      {
        "from": "../src/taminator",
        "to": "taminator",
        "filter": [
          "**/*",
          "!**/*.pyc",
          "!**/__pycache__"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "type": "distribution"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "jbyrd@redhat.com",
      "vendor": "Red Hat",
      "synopsis": "The Skynet TAMs actually want",
      "description": "RFE/Bug tracking tool for Red Hat TAMs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taminator"
    }
  }
}
